{
  "manifest_version": 3,
  "name": "OhMyPassword",
  "version": "0.2.3",
  "description": "连接本机 OhMyPassword，按网站匹配、填充和保存账号密码。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://dl.reg.163.com/*",
    "https://passport.126.com/*",
    "https://idmsa.apple.com/*"
  ],
  "action": {
    "default_title": "OhMyPassword",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*; frame-src 'none'; base-uri 'none'"
  },
  "key": ""
}
